<script>
  // Helper: compute credited hours from 24h HH:MM strings (subtracting 12:00-13:00 lunch)
  function computeHoursFromTimesClient(timeIn: string, timeOut: string): number {
    if (!timeIn || !timeOut) return 0;
    const [h1, m1] = timeIn.split(':').map(Number);
    const [h2, m2] = timeOut.split(':').map(Number);
    if (Number.isNaN(h1) || Number.isNaN(h2)) return 0;
    const inM = h1 * 60 + (m1 || 0);
    const outM = h2 * 60 + (m2 || 0);
    if (outM <= inM) return 0;
    const lStart = 12 * 60;
    const lEnd = 13 * 60;
    const overlap = Math.max(0, Math.min(outM, lEnd) - Math.max(inM, lStart));
    const workedMins = outM - inM - overlap;
    return Math.round((workedMins / 60) * 100) / 100;
  }

  // Helper: compute Time Out HH:MM from Time In + Credited Hours (adding 1h lunch if crossing 12:00)
  function computeTimeOutFromHoursClient(timeIn: string, creditedHours: number): string {
    const [h1, m1] = (timeIn || '07:00').split(':').map(Number);
    const startM = (Number.isNaN(h1) ? 7 : h1) * 60 + (m1 || 0);
    const neededM = Math.round(creditedHours * 60);
    let outM = startM + neededM;
    const lStart = 12 * 60;
    if (startM < lStart && outM > lStart) {
      outM += 60;
    }
    outM = Math.min(23 * 60 + 59, Math.max(startM, outM));
    const hh = String(Math.floor(outM / 60)).padStart(2, '0');
    const mm = String(outM % 60).padStart(2, '0');
    return `${hh}:${mm}`;
  }

  // View Switcher (Calendar Cradle vs. Step-by-Step Math)
  const viewTabs = document.querySelectorAll<HTMLButtonElement>('.view-tab');
  const viewCalendar = document.getElementById('view-calendar');
  const viewMath = document.getElementById('view-math');

  viewTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      viewTabs.forEach((t) => {
        t.classList.remove('active');
        t.setAttribute('aria-selected', 'false');
      });
      tab.classList.add('active');
      tab.setAttribute('aria-selected', 'true');

      const target = tab.dataset.viewTarget;
      if (viewCalendar && viewMath) {
        viewCalendar.hidden = target !== 'calendar';
        viewMath.hidden = target !== 'math';
      }
    });
  });

  // Month Selector Pills with sessionStorage persistence
  const monthBtns = document.querySelectorAll<HTMLButtonElement>('.month-pill');
  const monthSheets = document.querySelectorAll<HTMLElement>('.month-sheet');
  const monthsGrid = document.getElementById('months-grid');

  function activateMonthTab(selected: string) {
    monthBtns.forEach((b) => {
      const isMatch = b.dataset.monthBtn === selected;
      b.classList.toggle('active', isMatch);
      b.setAttribute('aria-selected', isMatch ? 'true' : 'false');
    });

    if (selected === 'all') {
      monthsGrid?.classList.add('all-months-grid');
      monthSheets.forEach((s) => (s.hidden = false));
    } else {
      monthsGrid?.classList.remove('all-months-grid');
      monthSheets.forEach((s) => {
        s.hidden = s.dataset.monthSheet !== selected;
      });
    }
    sessionStorage.setItem('ojt_active_month', selected);
  }

  monthBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      activateMonthTab(btn.dataset.monthBtn || '9');
    });
  });

  // Restore saved month tab on page load
  const savedMonth = sessionStorage.getItem('ojt_active_month');
  if (savedMonth) {
    activateMonthTab(savedMonth);
  }

  // Day Editor Elements
  const editor = document.getElementById('day-editor');
  const editorTitle = document.getElementById('editor-title');
  const editorSub = document.getElementById('editor-sub');
  const btnCloseEditor = document.getElementById('btn-close-editor');
  const inputDate = document.getElementById('input-date') as HTMLInputElement | null;
  const inputStatus = document.getElementById('input-status') as HTMLInputElement | null;
  const inputTimeIn = document.getElementById('input-time-in') as HTMLInputElement | null;
  const inputTimeOut = document.getElementById('input-time-out') as HTMLInputElement | null;
  const inputCredited = document.getElementById('input-credited') as HTMLInputElement | null;
  const liveCalcPreview = document.getElementById('live-calc-preview');
  const moveRow = document.getElementById('move-row');
  const inputMoveTo = document.getElementById('input-move-to') as HTMLInputElement | null;
  const btnMove = document.getElementById('btn-move');
  const customForm = document.getElementById('custom-form');
  const quickPills = document.querySelectorAll<HTMLButtonElement>('[data-quick-status]');
  const allDayCards = document.querySelectorAll<HTMLButtonElement>('.day-card:not(:disabled)');

  let selectedDate = '';

  function highlightActiveQuickPill(status: string) {
    quickPills.forEach((pill) => {
      pill.classList.toggle('active-pill', pill.dataset.quickStatus === status);
    });
  }

  function updateLivePreview(credited: number, status: string) {
    if (!liveCalcPreview) return;
    if (status === 'holiday') {
      liveCalcPreview.textContent = 'Holiday (excluded from workdays)';
      return;
    }
    const short = Math.max(0, Math.round((8.8 - credited) * 100) / 100);
    liveCalcPreview.textContent = `${credited.toFixed(2).replace(/\.00$/, '.0')}h credited (${short.toFixed(2).replace(/\.00$/, '.0')}h short)`;
  }

  function syncFromTimeInputs() {
    if (!inputTimeIn || !inputTimeOut || !inputCredited || !inputStatus) return;
    const hrs = computeHoursFromTimesClient(inputTimeIn.value, inputTimeOut.value);
    inputCredited.value = String(hrs);

    // Infer matching status from times/hours
    if (inputTimeIn.value === '07:00' && inputTimeOut.value === '16:48' && Math.abs(hrs - 8.8) < 0.05) {
      inputStatus.value = 'full';
    } else if (hrs === 0) {
      inputStatus.value = 'absent';
    } else if (inputTimeOut.value === '13:00' || inputTimeOut.value === '12:00' || Math.abs(hrs - 5.0) < 0.05) {
      inputStatus.value = 'half_day';
    } else {
      inputStatus.value = 'early_out';
    }

    highlightActiveQuickPill(inputStatus.value);
    updateLivePreview(hrs, inputStatus.value);
  }

  inputTimeIn?.addEventListener('input', syncFromTimeInputs);
  inputTimeIn?.addEventListener('change', syncFromTimeInputs);
  inputTimeOut?.addEventListener('input', syncFromTimeInputs);
  inputTimeOut?.addEventListener('change', syncFromTimeInputs);

  inputCredited?.addEventListener('input', () => {
    if (!inputCredited || !inputTimeIn || !inputTimeOut || !inputStatus) return;
    const hrs = Math.max(0, parseFloat(inputCredited.value) || 0);
    if (hrs === 0) {
      inputStatus.value = 'absent';
    } else {
      inputTimeOut.value = computeTimeOutFromHoursClient(inputTimeIn.value || '07:00', hrs);
      if (Math.abs(hrs - 8.8) < 0.05) {
        inputStatus.value = 'full';
      } else if (Math.abs(hrs - 5.0) < 0.05) {
        inputStatus.value = 'half_day';
      } else {
        inputStatus.value = 'early_out';
      }
    }
    highlightActiveQuickPill(inputStatus.value);
    updateLivePreview(hrs, inputStatus.value);
  });

  async function postAttendance(payload: Record<string, unknown>) {
    const res = await fetch('/api/attendance', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
    if (res.ok) {
      window.location.reload();
    }
  }

  allDayCards.forEach((card) => {
    card.addEventListener('click', () => {
      selectedDate = card.dataset.date || '';
      if (!selectedDate || !editor) return;

      allDayCards.forEach((c) => c.classList.remove('selected-day'));
      card.classList.add('selected-day');

      if (card.dataset.month && sessionStorage.getItem('ojt_active_month') !== 'all') {
        sessionStorage.setItem('ojt_active_month', card.dataset.month);
      }

      const [y, m, d] = selectedDate.split('-').map(Number);
      const nice = new Date(Date.UTC(y, m - 1, d)).toLocaleDateString('en-US', {
        weekday: 'long',
        month: 'long',
        day: 'numeric',
        year: 'numeric',
        timeZone: 'UTC',
      });

      if (editorTitle) editorTitle.textContent = nice;
      if (editorSub) {
        const wd = card.dataset.workday ? `Workday #${card.dataset.workday}` : 'Non-working / Holiday';
        editorSub.textContent = `${wd} · ${card.dataset.credited || '0'} hrs credited · ${card.dataset.cumulative || '0'} hrs cumulative`;
      }

      const rawStatus = card.dataset.status || 'full';
      const normStatus = rawStatus.startsWith('projected') ? 'full' : rawStatus;

      if (inputDate) inputDate.value = selectedDate;
      if (inputStatus) inputStatus.value = normStatus;

      const rawIn = card.dataset.timeIn || '07:00';
      const rawOut = card.dataset.timeOut || '16:48';
      const cleanIn = /^\d{2}:\d{2}$/.test(rawIn) ? rawIn : '07:00';
      const cleanOut = /^\d{2}:\d{2}$/.test(rawOut)
        ? rawOut
        : normStatus === 'half_day'
          ? '13:00'
          : normStatus === 'early_out'
            ? '15:12'
            : '16:48';

      if (inputTimeIn) {
        inputTimeIn.value = cleanIn;
        inputTimeIn.disabled = normStatus === 'absent' || normStatus === 'holiday';
      }
      if (inputTimeOut) {
        inputTimeOut.value = cleanOut;
        inputTimeOut.disabled = normStatus === 'absent' || normStatus === 'holiday';
      }

      const credVal = parseFloat(card.dataset.credited || '8.8');
      if (inputCredited) {
        inputCredited.value = String(credVal);
      }

      highlightActiveQuickPill(normStatus);
      updateLivePreview(credVal, normStatus);

      if (moveRow && inputMoveTo) {
        moveRow.hidden = normStatus === 'full';
        inputMoveTo.value = selectedDate;
      }

      editor.hidden = false;
      editor.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });
  });

  btnCloseEditor?.addEventListener('click', () => {
    if (editor) editor.hidden = true;
    allDayCards.forEach((c) => c.classList.remove('selected-day'));
  });

  // One-click status preset pills inside the editor
  quickPills.forEach((btn) => {
    btn.addEventListener('click', async () => {
      if (!selectedDate) return;
      const preset = btn.dataset.quickStatus || 'full';
      let tIn: string | null = '07:00';
      let tOut: string | null = '16:48';
      let cred = 8.8;

      if (preset === 'half_day') {
        tOut = '13:00';
        cred = 5.0;
      } else if (preset === 'early_out') {
        tOut = '15:12';
        cred = 7.2;
      } else if (preset === 'absent' || preset === 'holiday') {
        tIn = null;
        tOut = null;
        cred = 0.0;
      }

      await postAttendance({
        date: selectedDate,
        status: preset,
        time_in: tIn,
        time_out: tOut,
        credited_hours: cred,
      });
    });
  });

  // Saving Custom Time / Hours
  customForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!selectedDate || !inputStatus || !inputTimeIn || !inputTimeOut || !inputCredited) return;

    const cred = parseFloat(inputCredited.value);
    await postAttendance({
      date: selectedDate,
      status: inputStatus.value,
      time_in: inputTimeIn.disabled ? null : inputTimeIn.value,
      time_out: inputTimeOut.disabled ? null : inputTimeOut.value,
      credited_hours: Number.isNaN(cred) ? 8.8 : cred,
    });
  });

  btnMove?.addEventListener('click', async () => {
    if (!selectedDate || !inputMoveTo || !inputMoveTo.value || inputMoveTo.value === selectedDate) return;
    const targetMonth = String(Number(inputMoveTo.value.split('-')[1]) - 1);
    sessionStorage.setItem('ojt_active_month', targetMonth);
    await postAttendance({
      action: 'move',
      fromDate: selectedDate,
      toDate: inputMoveTo.value,
    });
  });

  // Nov 2 Holiday Switch
  const toggleNov2 = document.getElementById('toggle-nov2') as HTMLInputElement | null;
  toggleNov2?.addEventListener('change', async () => {
    await postAttendance({
      date: '2026-11-02',
      status: toggleNov2.checked ? 'holiday' : 'full',
      label: toggleNov2.checked ? "All Souls' Day Break" : null,
    });
  });

  // Reset Button
  document.getElementById('btn-reset-seed')?.addEventListener('click', async () => {
    const res = await fetch('/api/reset', { method: 'POST' });
    if (res.ok) window.location.reload();
  });
</script>

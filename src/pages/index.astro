  .day-card:not(:disabled):hover {
    transform: translateY(-2px);
    border-color: var(--accent-rose);
    box-shadow: var(--shadow-slot);
  }

  .day-card:disabled {
    cursor: default;
  }

  .day-empty {
    background: transparent;
    border-color: transparent;
  }

  .state-weekend,
  .state-unscheduled {

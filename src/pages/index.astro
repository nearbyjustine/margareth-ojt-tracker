  }

  .s-full { background: #eef8f2; border: 1px solid var(--status-full-border); }
  .s-proj { background: #fff; border: 1.5px dashed var(--status-full-border); }
  .s-half { background: var(--status-half-soft); border: 1px solid var(--status-half-border); }
  .s-early { background: var(--status-early-soft); border: 1px solid var(--status-early-border); }

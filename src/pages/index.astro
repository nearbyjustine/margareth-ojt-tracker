  .pill-full { color: var(--status-full); }
  .pill-projected { color: var(--status-full); opacity: 0.8; }
  .pill-half { color: var(--status-half); }
  .pill-early { color: var(--status-early); }
  .pill-absent { color: var(--status-absent); }
  .pill-holiday { color: var(--status-holiday); }
